{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://show-duino.com/schemas/showduino-production-v2.schema.json",
  "title": "Showduino Production v2 (.shdo)",
  "description": "Portable authoring/interchange format for a Showduino Production. Runtime and safety authority remain on the ESP32-P4 Show Engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "architecture",
    "compatibility",
    "devices",
    "tracks",
    "clips",
    "markers",
    "scenes",
    "assets",
    "safety",
    "globalSettings",
    "config",
    "package",
    "metadata"
  ],
  "properties": {
    "schema": { "const": "showduino-production-v2" },
    "project": { "$ref": "#/$defs/project" },
    "architecture": { "$ref": "#/$defs/architecture" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
    "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
    "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } },
    "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "safety": { "$ref": "#/$defs/safety" },
    "globalSettings": { "type": "object", "additionalProperties": true },
    "config": { "$ref": "#/$defs/config" },
    "package": { "$ref": "#/$defs/package" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "version", "createdAt", "updatedAt", "bpm", "duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "duration": { "type": "integer", "minimum": 1 }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "creator", "runtimeAuthority", "operator", "transport", "nodeAddressing"],
      "properties": {
        "version": { "const": 1 },
        "creator": { "const": "showduino-studio" },
        "runtimeAuthority": { "const": "esp32-p4-show-engine" },
        "operator": { "const": "esp32-s3-director" },
        "transport": { "const": "esp32-s3-comms-controller" },
        "nodeAddressing": { "const": "logical-device-id" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shdoMajor", "minimumStudioVersion", "minimumRuntimeProtocol"],
      "properties": {
        "shdoMajor": { "const": 2 },
        "minimumStudioVersion": { "type": "string", "minLength": 1 },
        "minimumRuntimeProtocol": { "type": "integer", "minimum": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "output": { "type": "integer", "minimum": 0 },
        "channel": { "type": "integer", "minimum": 0 },
        "pixelStart": { "type": "integer", "minimum": 0 },
        "pixelCount": { "type": "integer", "minimum": 1 }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "type", "enabled"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "binding": { "$ref": "#/$defs/binding" },
        "capabilities": { "type": "object", "additionalProperties": true },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "enabled", "locked", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 },
        "targetDeviceId": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "delayMs", "durationMs", "value", "notes", "params"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "targetDeviceId": { "type": "string", "minLength": 1 },
        "delayMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "value": {},
        "notes": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trackId", "sceneId", "cueId", "name", "type", "startMs", "durationMs", "enabled", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "trackId": { "type": "string", "minLength": 1 },
        "sceneId": { "type": "string", "minLength": 1 },
        "cueId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "startMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "targetDeviceId": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "timeMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "timeMs": { "type": "integer", "minimum": 0 }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "trigger", "notes", "clipIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "clipIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "order", "cues"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "cues": { "type": "array", "items": { "$ref": "#/$defs/cue" } }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "type", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "checksum": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeAuthority", "policy", "emergency"],
      "properties": {
        "runtimeAuthority": { "const": "esp32-p4-show-engine" },
        "policy": { "const": "firmware-authoritative" },
        "emergency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stopTimeline", "pixelOverride", "requiresManualClear", "autoResume", "productionCannotDisable"],
          "properties": {
            "stopTimeline": { "const": true },
            "pixelOverride": { "const": "all-white" },
            "requiresManualClear": { "const": true },
            "autoResume": { "const": false },
            "productionCannotDisable": { "const": true }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapEnabled", "snapMs", "gridEnabled", "zoom"],
      "properties": {
        "snapEnabled": { "type": "boolean" },
        "snapMs": { "type": "integer", "minimum": 1 },
        "gridEnabled": { "type": "boolean" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "architecture", "runtimeAuthority"],
      "properties": {
        "format": { "const": "showduino-production" },
        "version": { "const": 2 },
        "architecture": { "const": "director-comms-p4-nodes" },
        "runtimeAuthority": { "const": "esp32-p4-show-engine" }
      }
    }
  }
}
